{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oids:schema:common:0.1.0",
  "title": "OIDS Common Definitions",
  "type": "object",
  "$defs": {
    "Identifier": {
      "type": "string",
      "minLength": 1,
      "format": "uri-reference"
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "EntityReference": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "href": {
          "type": "string",
          "format": "uri-reference"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "ExternalIdentifier": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "format": "uri-reference"
        }
      },
      "required": [
        "system",
        "value"
      ],
      "additionalProperties": false
    },
    "VocabularyTerm": {
      "type": "object",
      "properties": {
        "standardId": {
          "type": "string",
          "format": "uri-reference"
        },
        "code": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "sourceSystem": {
          "type": "string"
        },
        "sourceValue": {}
      },
      "anyOf": [
        {
          "required": [
            "standardId"
          ]
        },
        {
          "required": [
            "code"
          ]
        },
        {
          "required": [
            "label"
          ]
        },
        {
          "required": [
            "sourceSystem",
            "sourceValue"
          ]
        }
      ],
      "additionalProperties": false
    },
    "ActorReference": {
      "$ref": "#/$defs/EntityReference"
    },
    "Authorship": {
      "type": "object",
      "properties": {
        "actor": {
          "$ref": "#/$defs/ActorReference"
        },
        "authoredAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "method": {
          "enum": [
            "human",
            "ai",
            "device",
            "rule",
            "imported",
            "mixed"
          ]
        },
        "tool": {
          "$ref": "#/$defs/EntityReference"
        },
        "modelName": {
          "type": "string"
        },
        "modelVersion": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "actor",
        "authoredAt",
        "method"
      ],
      "additionalProperties": false
    },
    "Review": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/VocabularyTerm"
        },
        "reviewedBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActorReference"
          },
          "uniqueItems": true
        },
        "reviewedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "comment": {
          "type": "string"
        },
        "attestation": {
          "type": "string"
        },
        "credentialIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "Quantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "qualifier": {
          "$ref": "#/$defs/VocabularyTerm"
        },
        "precision": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "value"
      ],
      "additionalProperties": false
    },
    "NormalizedPoint": {
      "type": "object",
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false
    },
    "NormalizedGeometry": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "Point",
            "BoundingBox",
            "LineString",
            "Polygon"
          ]
        },
        "point": {
          "$ref": "#/$defs/NormalizedPoint"
        },
        "min": {
          "$ref": "#/$defs/NormalizedPoint"
        },
        "max": {
          "$ref": "#/$defs/NormalizedPoint"
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/NormalizedPoint"
          }
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "Point"
              }
            }
          },
          "then": {
            "required": [
              "point"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "BoundingBox"
              }
            }
          },
          "then": {
            "required": [
              "min",
              "max"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "LineString",
                  "Polygon"
                ]
              }
            }
          },
          "then": {
            "required": [
              "points"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "ExtensionObject": {
      "type": "object",
      "propertyNames": {
        "minLength": 3
      },
      "additionalProperties": true
    },
    "BaseEntity": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/Identifier"
        },
        "type": {
          "type": "string"
        },
        "schemaVersion": {
          "const": "0.1.0"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "createdAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "updatedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "createdBy": {
          "$ref": "#/$defs/ActorReference"
        },
        "externalIdentifiers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalIdentifier"
          }
        },
        "parentId": {
          "$ref": "#/$defs/Identifier"
        },
        "tags": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VocabularyTerm"
          }
        },
        "extensions": {
          "$ref": "#/$defs/ExtensionObject"
        }
      },
      "required": [
        "id",
        "type",
        "schemaVersion",
        "title",
        "createdAt",
        "createdBy"
      ]
    }
  }
}
