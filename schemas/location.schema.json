{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oids:schema:location:0.1.0",
  "title": "OIDS Location",
  "allOf": [
    {
      "$ref": "urn:oids:schema:common:0.1.0#/$defs/BaseEntity"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "Location"
        },
        "assetId": {
          "$ref": "urn:oids:schema:common:0.1.0#/$defs/Identifier"
        },
        "locationType": {
          "$ref": "urn:oids:schema:common:0.1.0#/$defs/VocabularyTerm"
        },
        "assetPath": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "$ref": "urn:oids:schema:common:0.1.0#/$defs/VocabularyTerm"
              },
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "name"
            ],
            "additionalProperties": false
          }
        },
        "address": {
          "type": "object",
          "properties": {
            "lines": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "locality": {
              "type": "string"
            },
            "region": {
              "type": "string"
            },
            "postalCode": {
              "type": "string"
            },
            "countryCode": {
              "type": "string",
              "minLength": 2,
              "maxLength": 2
            }
          },
          "additionalProperties": false
        },
        "geographic": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "Point",
                "LineString",
                "Polygon"
              ]
            },
            "coordinates": {
              "type": "array"
            },
            "crs": {
              "type": "string",
              "default": "EPSG:4326"
            }
          },
          "required": [
            "type",
            "coordinates"
          ],
          "additionalProperties": false
        },
        "drawing": {
          "type": "object",
          "properties": {
            "documentId": {
              "$ref": "urn:oids:schema:common:0.1.0#/$defs/Identifier"
            },
            "sheet": {
              "type": "string"
            },
            "page": {
              "type": "integer",
              "minimum": 1
            },
            "revision": {
              "type": "string"
            },
            "sourceWidth": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sourceHeight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "sourceUnit": {
              "type": "string"
            },
            "coordinateOrigin": {
              "const": "top-left"
            },
            "geometry": {
              "$ref": "urn:oids:schema:common:0.1.0#/$defs/NormalizedGeometry"
            }
          },
          "required": [
            "documentId",
            "geometry"
          ],
          "additionalProperties": false
        },
        "image": {
          "type": "object",
          "properties": {
            "evidenceId": {
              "$ref": "urn:oids:schema:common:0.1.0#/$defs/Identifier"
            },
            "sourceWidth": {
              "type": "integer",
              "minimum": 1
            },
            "sourceHeight": {
              "type": "integer",
              "minimum": 1
            },
            "coordinateOrigin": {
              "const": "top-left"
            },
            "geometry": {
              "$ref": "urn:oids:schema:common:0.1.0#/$defs/NormalizedGeometry"
            }
          },
          "required": [
            "evidenceId",
            "geometry"
          ],
          "additionalProperties": false
        },
        "bim": {
          "type": "object",
          "properties": {
            "modelId": {
              "type": "string"
            },
            "modelVersion": {
              "type": "string"
            },
            "ifcGlobalId": {
              "type": "string"
            },
            "ifcEntity": {
              "type": "string"
            },
            "bcfViewpointId": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "pointCloud": {
          "type": "object",
          "properties": {
            "datasetId": {
              "type": "string"
            },
            "crs": {
              "type": "string"
            },
            "coordinates": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            }
          },
          "required": [
            "datasetId",
            "coordinates"
          ],
          "additionalProperties": false
        },
        "freeText": {
          "type": "string"
        }
      },
      "required": [
        "type",
        "assetId"
      ]
    }
  ],
  "unevaluatedProperties": false
}
